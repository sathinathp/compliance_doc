# Copy this file to .env. The server reads it at startup.
PORT=4100
AEGIS_BASE_URL=https://aegis.example.com
AEGIS_DEMO=0                  # 1 loads demo tenants, mock HRMS and demo controls
AEGIS_SECRET=change-me        # encrypts stored documents and connector credentials
AEGIS_DATA=/var/lib/aegis     # database file (SQLite only), documents and the generated secret

# Backups. The server makes one a day (database rows and documents, never the secret) and keeps
# the newest 14. Copy the backup folder off this computer, and keep AEGIS_SECRET somewhere else.
# AEGIS_BACKUP_DIR=/var/backups/aegis   # default: AEGIS_DATA/backups
# AEGIS_BACKUP_KEEP=14
# AEGIS_BACKUPS=off                     # only when the database is backed up another way

# Production. With NODE_ENV=production Aegis refuses to start unless:
#   AEGIS_DEMO=0, AEGIS_SECRET is at least 32 random characters,
#   AEGIS_BASE_URL starts with https://, and PostgreSQL is reachable.
# Make a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the secret safe and never change it: documents saved with one secret cannot be read with another.
# NODE_ENV=production

# Pilot setup. Only used by `npm run provision:bluebix`, which creates the empty Bluebix
# workspace and its first administrator. Running it again leaves an existing password unchanged.
# AEGIS_PILOT_ADMIN_EMAIL=admin@bluebix.com
# AEGIS_PILOT_ADMIN_NAME=
# AEGIS_PILOT_ADMIN_PASSWORD=   # generated, at least 16 characters

# PostgreSQL. Fill in these five values; type the password exactly as it is
# (no encoding needed, even with @ or #). If the password contains #, wrap it
# in double quotes: PGPASSWORD="pa#ss". When PGUSER and PGDATABASE are set,
# they are used instead of DATABASE_URL. Without any of these, development
# uses a local SQLite file; production stops with an error.
PGHOST=localhost
PGPORT=5432
PGUSER=aegis
PGPASSWORD=
PGDATABASE=aegis

# Alternative: one URL instead of the five values above. Special characters in
# the password must be encoded here (@ -> %40, # -> %23, : -> %3A, / -> %2F).
# DATABASE_URL=postgresql://aegis:PASSWORD@localhost:5432/aegis

# A query that runs longer than this is cancelled (milliseconds).
# AEGIS_DB_STATEMENT_TIMEOUT_MS=30000
# Only for server/lib/migrate-to-pg.js, when psql is not on PATH.
# PSQL_PATH=C:\Program Files\PostgreSQL\18\bin\psql.exe

# HRMS: set up in the app (or POST /api/connectors), not here. See docs/HRMS-CONNECTOR.md.

# Optional AI for reading evidence and the coworker chat. The main provider is tried first; if it fails
# (outage, rejected key, no credit, timeout) the fallback provider answers instead.
AEGIS_LLM_PROVIDER=anthropic   # main provider: anthropic or deepseek
AEGIS_LLM_FALLBACK=deepseek    # optional second provider
# AEGIS_LLM_MODEL=             # optional model for the main provider (default claude-haiku-4-5-20251001)
# AEGIS_LLM_FALLBACK_MODEL=    # optional model for the fallback (default deepseek-flash)
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Optional custom provider endpoints. Separate full approved HTTPS URLs with commas.
# AEGIS_LLM_CUSTOM_ENDPOINTS=https://provider.example/v1/chat/completions

# Optional email to workers and owners. Use SMTP or Resend. Without either,
# messages stay in the in-app outbox and say so.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=
# EMAIL_FROM=Aegis <compliance@example.com>

# Optional Slack, for local development only. In production each company connects Slack in the app.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=              # Socket Mode token (xapp-...)
SLACK_SIGNING_SECRET=
